# 站点路由段:宿主机 Caddy 经 /etc/caddy/Caddyfile 的 import 加载(design/07);
# 服务器 80/443 由宿主机 Caddy 统一网关(与 mailer 等其他服务共用),本文件只管本站。
# 安全头统一在此追加(design/06)。同步方式:scp 到 /opt/homepage/ 后 systemctl reload caddy。
linlang.me {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 资产文件:内容 hash 命名,边缘与浏览器永久缓存
	handle_path /uploads/* {
		root * /opt/homepage/data/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		# svg 可内嵌脚本,sandbox 禁其执行(img/背景引用不受影响)
		@svg path *.svg
		header @svg Content-Security-Policy "sandbox"
		file_server
	}

	# 备用静态区(design/03)
	handle_path /pages/* {
		root * /opt/homepage/data/pages
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# 需要 www 时:Cloudflare 加 CNAME www → linlang.me 后取消本段注释
# www.linlang.me {
# 	redir https://linlang.me{uri} permanent
# }
