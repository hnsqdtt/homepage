# ── 认证(design/06)────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App 凭据(dev/prod 两个 App 各一套,勿混用)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 站点对外地址:dev 用 http://localhost:3000,prod 用 https://linlang.me
AUTH_URL=http://localhost:3000
# 管理员 GitHub 数字 ID 白名单(单人)
ADMIN_GITHUB_ID=

# ── 数据与站点 ──────────────────────────────────────
# 唯一可变数据目录(design/00 硬约束;容器内为 /data)
DATA_DIR=./data
# 游客端绝对链接前缀(RSS / sitemap / OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
